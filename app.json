{
  "expo": {
    "name": "DataLakeFaceAuth",
    "slug": "datalakefaceauth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "assets/**/*",
      "assets/models/**/*",
      "assets/mediapipe/**/*"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.anonymous.datalakefaceauth"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.datalakefaceauth",
      "supportsTablet": true
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Face authentication ke liye camera chahiye"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "expo-asset"
    ]
  }
}